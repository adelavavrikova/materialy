#to nahore jsem nepouzila tak jak jsem chtela, chci, aby to bude reklo, ze je to obdelnik nebo ctverec, takze musim pouzit elif

a = int(input("Zadej stranu a"))
b = int(input("Zadej stranu b"))

#tohle porad nedela co chci, protoze mi to rovnou napise ten obdelnik, ja bych chtela, aby to napsalo az ctverec

if a>0 and b>0:
    print("Obsah obdelniku je", a*b)
elif a == b:
    print("Toto je ctverec a jeho obsah je", a*b)
else:
    print("Toto neni obdelnik ani ctverec")